# ====================================================================
# LiteValley Headless - Konfigurasi Lingkungan (.env)
# ====================================================================

# Port Jaringan
PORT=24642                  # Port Netcode Lidgren UDP (Wajib dibuka di Firewall / Router)
WEB_PORT=5000               # Port Web UI Control Panel HTTP (Akses via browser http://ip-anda:5000)

# Kredensial Administrator Web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordKuatIni123!

# Konfigurasi Dunia Game
SERVER_NAME=LiteValley Dedicated Server
FARM_NAME=LembahMakmur
FARM_TYPE=0                 # 0=Standard, 1=Riverland, 2=Forest, 3=Hill-top, 4=Wilderness, 5=Four Corners, 6=Beach, 7=Meadowlands
MAX_PLAYERS=10              # Jumlah pemain simultan maksimum
SERVER_PASSWORD=            # Kosongkan jika server publik tanpa password join

# Kredensial Steam (Zero-Piracy Requirement)
# Dapatkan token resmi dengan menjalankan perintah login Steam (lihat README.md)
STEAM_REFRESH_TOKEN=

# Keamanan Redis Internal
REDIS_PASSWORD=litevalley_redis_secret_ganti_ini

# Zona Waktu
TZ=Asia/Jakarta
