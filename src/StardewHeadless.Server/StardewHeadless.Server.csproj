<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <GamePath Condition="'$(GamePath)' == '' and '$(STARDEW_GAME_DIR)' != ''">$(STARDEW_GAME_DIR)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('D:\SteamLibrary\steamapps\common\Stardew Valley\Stardew Valley.dll')">D:\SteamLibrary\steamapps\common\Stardew Valley</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\ref-assemblies\Stardew Valley.dll')">$(MSBuildThisFileDirectory)..\..\ref-assemblies</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">/data/game</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StardewHeadless.Protocol\StardewHeadless.Protocol.csproj" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.27" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <!-- Reference Stardew Valley assemblies from the game installation -->
  <ItemGroup>
    <Reference Include="Stardew Valley">
      <HintPath>$(GamePath)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(GamePath)\StardewValley.GameData.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidgren.Network">
      <HintPath>$(GamePath)\Lidgren.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(GamePath)\xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
